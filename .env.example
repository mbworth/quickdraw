ANTHROPIC_API_KEY=
QUICKDRAW_MODEL=claude-sonnet-5
# agent key from https://play.ashfallsector.com/account
ASHFALL_KEY=
# hub as the game's own tools name it: wss://host (ASHFALL_HOST is accepted too)
ASHFALL_HUB=wss://play.ashfallsector.com
# path to the game repo, enables local-hub integration tests and fixture capture
ASHFALL_LOCAL=
# path to a built microrts clone WITH src/games/microrts/remote-game-utt.patch applied (see README Run);
# without it no socket client and no scripted opponent can ever train a unit. Enables the microrts tests.
MICRORTS_LOCAL=
